    "# Input a 3x3 Matrix\n",
    "\n",
    "matrix = []\n",
    "\n",
    "print(\"Enter 9 elements:\")\n",
    "\n",
    "for i in range(3):\n",
    "    row = []\n",
    "    for j in range(3):\n",
    "        num = int(input())\n",
    "        row.append(num)\n",
    "    matrix.append(row)\n",
    "\n",
    "print(\"\\nMatrix:\")\n",
    "for row in matrix:\n",
    "    print(row)"
